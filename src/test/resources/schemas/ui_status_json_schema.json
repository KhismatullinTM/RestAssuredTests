{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "state",
    "origin",
    "version"
  ],
  "properties": {
    "state": {
      "type": "object",
      "required": [
        "total",
        "used",
        "queued",
        "pending"
      ],
      "properties": {
        "total": {
          "type": "number"
        },
        "used": {
          "type": "number"
        },
        "queued": {
          "type": "number"
        },
        "pending": {
          "type": "number"
        }
      }
    },
    "origin": {
      "type": "string"
    },
    "version": {
      "type": "string"
    }
  }
}